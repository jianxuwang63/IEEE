% Graphical Abstract — IEEE JBHI
% Compile: pdflatex this_file
% Output: PDF → convert to 660×295 px JPG at 300 dpi
\documentclass[tikz, border=0pt]{standalone}
\usepackage{tikz}
\usepackage{xcolor}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, backgrounds, calc, fit, patterns}

% --- Palette ---
\definecolor{cDanger}{HTML}{C0392B}
\definecolor{cPhaseI}{HTML}{E67E22}   % amber / CSL
\definecolor{cPhaseII}{HTML}{2471A3}  % steel blue / NP
\definecolor{cPhaseIII}{HTML}{1E8449} % green / Selective
\definecolor{cInput}{HTML}{7D3C98}    % purple / input
\definecolor{cOutput}{HTML}{0E6655}   % dark teal / output
\definecolor{cBg}{HTML}{F8F9FA}
\definecolor{cText}{HTML}{2C3E50}
\definecolor{cGray}{HTML}{AAB7B8}

\begin{document}
\begin{tikzpicture}[
    x=1cm, y=1cm,
    %
    mainbox/.style n args={2}{
        rectangle, rounded corners=5pt,
        draw=#1!35, fill=white, line width=0.7pt,
        minimum width=#2, minimum height=1.7cm,
        inner sep=5pt, align=center, font=\sffamily
    },
    %
    topbar/.style={
        rectangle, fill=#1, rounded corners=2pt,
        minimum width=2.6cm, minimum height=0.10cm,
        inner sep=0pt, anchor=north
    },
    %
    arrow/.style={-{Stealth[round, length=4pt, width=4pt]}, line width=1.0pt, draw=cGray!80},
    %
    sectiontitle/.style={font=\sffamily\scriptsize\bfseries, text=cGray, letter-spacing=0.5},
    %
    % box text styles
    boxtitle/.style={font=\sffamily\footnotesize\bfseries, text=cText},
    boxdesc/.style={font=\sffamily\scriptsize, text=cText!80},
    boxmetric/.style={font=\sffamily\footnotesize\bfseries},
]

% ===== TITLE AREA (top) =====
\node[font=\sffamily\bfseries\Large, text=cText] at (9.5, 1.6) {
    A Risk-Controlled Framework with Guaranteed Confidence
};
\node[font=\sffamily\small, text=cText!70] at (9.5, 1.0) {
    for Lung Adenocarcinoma Micropapillary Subtype Classification
};

% ===== LEFT: Clinical Problem =====
\node[mainbox={cInput}{2.8cm}] (inp) at (0, -0.15) {
    \boxtitle MIP Pathology Images\\[2pt]
    \boxdesc 7,133 ROI microscopy\\[-1pt]
    \boxdesc images, MIP-labeled\\[2pt]
    {\boxmetric\color{cDanger} Rare + Aggressive}\\[-1pt]
    {\boxmetric\color{cDanger} $\approx$ 1 : 3.7 imbalance}
};
\node[topbar=cInput] at (inp.north) {};
% icon — four tile squares
\draw[cInput!25, fill=cInput!8, rounded corners=1pt] (-1.1, 0.65) rectangle ++(0.38,0.38);
\draw[cInput!25, fill=cInput!8, rounded corners=1pt] (-0.65, 0.65) rectangle ++(0.38,0.38);
\draw[cInput!25, fill=cInput!12, rounded corners=1pt] (-1.1, 0.2) rectangle ++(0.38,0.38);
\draw[cInput!25, fill=cInput!12, rounded corners=1pt] (-0.65, 0.2) rectangle ++(0.38,0.38);

% ===== BASELINE =====
\node[mainbox={cDanger}{2.8cm}] (base) at (4.3, -0.15) {
    \boxtitle ViT-MIL Baseline\\[2pt]
    \boxdesc Phikon encoder\\[-1pt]
    \boxdesc Gated attention pooling\\[2pt]
    {\boxmetric ACC 93.4\%\quad|\quad}
    {\boxmetric\color{cDanger} FNR 16.1\%}
};
\node[topbar=cDanger] at (base.north) {};

% ===== PHASE I: CSL =====
\node[mainbox={cPhaseI}{3.0cm}] (p1) at (8.0, -0.15) {
    \boxtitle Phase I\\[1pt]
    \boxdesc Cost-Sensitive Learning\\[1pt]
    \boxdesc Reweight loss $w_1\!:\!w_0 = 10\!:\!1$\\[2pt]
    {\boxmetric\color{cPhaseI} FNR $\downarrow$ 3.6\%}
};
\node[topbar=cPhaseI] at (p1.north) {};
\node[sectiontitle] at (8.0, 0.85) {TRAINING};

% ===== PHASE II: NP =====
\node[mainbox={cPhaseII}{3.0cm}] (p2) at (11.8, -0.15) {
    \boxtitle Phase II\\[1pt]
    \boxdesc Neyman--Pearson Calibration\\[1pt]
    \boxdesc Order-statistic threshold\\[2pt]
    {\boxmetric\color{cPhaseII} $\mathbb{P}(\text{FNR}\!>\!\alpha)\leq\delta$}
};
\node[topbar=cPhaseII] at (p2.north) {};
\node[sectiontitle] at (11.8, 0.85) {CALIBRATION};

% ===== PHASE III: Selective =====
\node[mainbox={cPhaseIII}{3.2cm}] (p3) at (15.8, -0.15) {
    \boxtitle Phase III\\[1pt]
    \boxdesc Selective Classification\\[1pt]
    \boxdesc SelectiveNet + CRC calibration\\[2pt]
    {\boxmetric\color{cPhaseIII} Coverage 91.0\%\ |\ FNR 5.1\%}
};
\node[topbar=cPhaseIII] at (p3.north) {};
\node[sectiontitle] at (15.8, 0.85) {DECISION};

% ===== RIGHT: Output =====
\node[mainbox={cOutput}{2.6cm}] (out) at (19.0, -0.15) {
    \boxtitle Clinical Deployment\\[4pt]
    \boxdesc FNR bounded \& guaranteed\\[-1pt]
    \boxdesc Uncertain $\to$ pathologist\\[-1pt]
    \boxdesc Confident $\to$ automated
};
\node[topbar=cOutput] at (out.north) {};

% ===== ARROWS =====
\draw[arrow] (inp.east)  -- (base.west);
\draw[arrow] (base.east) -- (p1.west);
\draw[arrow] (p1.east)   -- (p2.west);
\draw[arrow] (p2.east)   -- (p3.west);
\draw[arrow] (p3.east)   -- (out.west);

% ===== BOTTOM PANEL =====
\begin{scope}[on background layer]
    \fill[cBg, rounded corners=6pt] (0.2, -2.5) rectangle (18.8, -3.8);
\end{scope}

% Three insight columns
\node[font=\sffamily\footnotesize, align=center, text width=5.2cm, inner sep=4pt] at (4.3, -3.1) {
    {\bfseries\color{cPhaseI} Clinical Challenge}\\[2pt]
    MIP is a rare yet aggressive LUAD subtype.\\
    Standard DL models optimize average accuracy\\
    and produce unacceptably high false-negative rates.
};

\node[font=\sffamily\footnotesize, align=center, text width=5.2cm, inner sep=4pt] at (9.5, -3.1) {
    {\bfseries\color{cPhaseII} Our Approach}\\[2pt]
    Three complementary phases acting in concert:\\
    CSL penalizes missed diagnoses $\to$ NP provides\\
    a formal FNR guarantee $\to$ SelectiveNet defers\\
    ambiguous cases to human pathologists.
};

\node[font=\sffamily\footnotesize, align=center, text width=5.2cm, inner sep=4pt] at (14.7, -3.1) {
    {\bfseries\color{cPhaseIII} Key Result}\\[2pt]
    FNR reduced from {\bfseries 16.1\%} to {\bfseries 5.1\%}\\
    at {\bfseries 91.0\%} coverage, with a rigorous\\
    statistical guarantee on the missed-diagnosis rate.
};

% Vertical dividers
\draw[cGray!30, line width=0.3pt] (7.0, -2.7) -- (7.0, -3.6);
\draw[cGray!30, line width=0.3pt] (12.0, -2.7) -- (12.0, -3.6);

\end{tikzpicture}
\end{document}
