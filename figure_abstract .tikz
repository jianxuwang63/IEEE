% Redesigned Graphical Abstract — Modern Aesthetic with Harmoneous Palette
% Compile: pdflatex -> convert -density 300 out.pdf -resize 660x295 abstract.jpg
\documentclass[tikz, border=0pt]{standalone}
\usepackage{tikz}
\usepackage{xcolor}
\usepackage{amsmath}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, backgrounds, calc, fit, shadows}

% --- Palette: A New, Modern & Sophisticated Academic Palette ---
\definecolor{cBase}{HTML}{1E3A8A}    % Deep Navy Blue
\definecolor{cP1}{HTML}{D97706}      % Warm Amber/Gold (CSL - Weighting)
\definecolor{cP2}{HTML}{3B82F6}      % Vibrant Royal Blue (Calibration - Standard)
\definecolor{cP3}{HTML}{059669}      % Modern Emerald Green (Decision - Success)
\definecolor{cOut}{HTML}{6D28D9}     % Modern Indigo/Plum (Deployment)
\definecolor{cDanger}{HTML}{C0392B}  % Sophisticated Crimson (High FNR)
\definecolor{cBg}{HTML}{F8FAFC}      % Ultra Light Grey/White
\definecolor{cText}{HTML}{0F172A}    % Very Dark Grey-Blue
\definecolor{cIcon}{HTML}{F1F5F9}    % Icon Color

\begin{document}
\begin{tikzpicture}[
    box/.style n args={2}{
        rectangle, rounded corners=6pt, fill=#1, draw=#1!90!black, line width=0.5pt,
        minimum width=#2, minimum height=1.0cm, inner sep=5pt, align=center,
        font=\sffamily\color{white}, drop shadow={opacity=0.1, shadow xshift=1pt, shadow yshift=-1pt}
    },
    icon/.style={inner sep=1pt, color=cIcon!80},
    arrow/.style={-{Stealth[round, length=3pt, width=3pt]}, line width=0.8pt, draw=cText!50},
    dashed_arrow/.style={-{Stealth[round, length=3pt, width=3pt]}, line width=0.8pt, draw=cText!50, dashed}
]

% Subtle textured background (microscopy pattern - requires tikz patterns, simplified here for compile speed)
\begin{scope}[on background layer]
    \fill[cBg] (-1.2, -4.5) rectangle (14.8, 3.8);
    % Subtle text for context
    \node[font=\sffamily\tiny, text=cText!20, rotate=15] at (14.1, 3.2) {WSI DATA};
    \node[font=\sffamily\tiny, text=cText!15, rotate=-10] at (0, 3.2) {LUAD SUBTYPE};
\end{scope}

% ===== TOP: Baseline (single box, centered) =====
\node[box={cBase}{5.2cm}, minimum height=1.3cm] (base) at (6.8, 1.8) {
    \node[icon] (eye) {\small\faEye};
    {\bfseries\large ViT-MIL Baseline}\\[2pt]
    {\small Phikon encoder + Gated Attention Pooling}\\[0pt]
    {\small\color{white!85} ACC 93.41\% \quad|\quad \color{cDanger!30!white}\bfseries FNR 16.06\%}
};

% ===== MIDDLE: Three Phases =====
\node[box={cP1}{3.8cm}, minimum height=1.7cm] (p1) at (0.8, -0.3) {
    \node[icon] (weight) {\small\faBalanceScaleRight};
    {\bfseries Phase I}\\[1pt]
    {\footnotesize Cost-Sensitive Learning}\\[2pt]
    {\scriptsize Reweight loss $w_1\!:\!w_0=10\!:\!1$}\\[0pt]
    {\scriptsize Boosts intrinsic sensitivity}\\[2pt]
    {\bfseries FNR 3.62\% \quad|\quad Heuristic}
};

\node[box={cP2}{3.8cm}, minimum height=1.7cm] (p2) at (6.8, -0.3) {
    \node[icon] (caliper) {\small\faCaliper};
    {\bfseries Phase II (CSL + NP)}\\[1pt]
    {\footnotesize NP Threshold Calibration}\\[2pt]
    {\scriptsize Order-statistic bounding}\\[0pt]
    {\scriptsize $\mathbb{P}(\text{FNR}\!>\!\alpha)\leq\delta$}\\[2pt]
    {\bfseries FNR 5.33\% \quad|\quad ACC 85.91\%}
};

\node[box={cP3}{3.8cm}, minimum height=1.7cm] (p3) at (12.8, -0.3) {
    \node[icon] (check) {\small\faHandPointRight};
    {\bfseries Phase III (CSL + CRC)}\\[1pt]
    {\footnotesize Selective Classification}\\[2pt]
    {\scriptsize FNR-centric thresholding}\\[0pt]
    {\scriptsize Accept / Defer uncertain}\\[2pt]
    {\bfseries Cov.\ 91.02\% \quad|\quad FNR 5.07\%}
};

% ===== BOTTOM: Deployment =====
\node[box={cOut}{7.4cm}, minimum height=1.2cm] (out) at (6.8, -2.55) {
    \node[icon] (heart) {\small\faHeartbeat};
    {\bfseries\large Human-in-the-Loop Clinical Deployment}\\[2pt]
    {\small Safe automated diagnosis \quad|\quad Uncertain $\to$ pathologist review}
};

% ===== ARROWS: Logical Progression =====
% Baseline feeds into Phase I (Training)
\draw[arrow] (base.west) -| (p1.north);

% Phase I feeds into Phase II and Phase III
\draw[arrow] (p1.east) -- (p2.west) node[midway, above, font=\sffamily\tiny, text=cText!80] {Boosts};
\draw[arrow] (p1.south) .. controls +(down:0.8cm) and +(down:0.8cm) .. (p3.south) node[midway, below, font=\sffamily\tiny, text=cText!80] {Recovers Coverage (Case 4)};

% Phase II and III feed into Deployment
\draw[dashed_arrow] (p2.south) -- (out.north) node[midway, right, font=\sffamily\tiny, text=cText!80] {Fully Automated};
\draw[arrow] (p3.south west) .. controls +(down:0.3cm) and +(up:0.4cm) .. (out.north east) node[midway, right, font=\sffamily\tiny, text=cText!80] {Selective};

% ===== PHASE LABELS =====
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] (labTr) at (0.8, 1.1)  {\textsc{Training}};
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] (labCa) at (6.8, 1.1)  {\textsc{Calibration}};
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] (labDe) at (12.8, 1.1) {\textsc{Decision}};

% Subtle connector lines for labels
\draw[line width=0.4pt, cText!20] (labTr.south) -- (p1.north);
\draw[line width=0.4pt, cText!20] (labCa.south) -- (p2.north);
\draw[line width=0.4pt, cText!20] (labDe.south) -- (p3.north);

% ===== FNR PROGRESSION BAR =====
\begin{scope}[on background layer]
    \fill[white, rounded corners=4pt, drop shadow={opacity=0.05, shadow yshift=-1pt}] (-1.0, -3.7) rectangle (14.6, -4.4);
    % New gradient progression fill
    \shade[left color=cDanger!80!white, right color=cP3, rounded corners=3pt] (-1.0, -3.7) rectangle (14.6, -4.4);
\end{scope}

\node[font=\sffamily\footnotesize, text=white] at (6.8, -4.05) {
    \color{cDanger}\textbf{FNR 16.06\%}
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP1}\textbf{FNR 3.62\%}\ (heuristic)
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP2}\textbf{FNR $\leq\alpha$}\ (guaranteed)
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP3}\textbf{FNR 5.07\%}\ (safe + high coverage)
};

% ===== SUBTITLE =====
\node[font=\sffamily\bfseries\Large, text=cText] at (6.8, 3.5) {
    A Risk-Controlled Framework with Guaranteed Confidence
};
\node[font=\sffamily\small, text=cText!60] at (6.8, 3.0) {
    for Lung Adenocarcinoma MIP Subtype Classification
};

\end{tikzpicture}
\end{document}