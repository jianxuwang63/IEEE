% Graphical Abstract — IEEE JBHI (660 × 295 px)
% Compile: pdflatex → convert -density 300 out.pdf -resize 660x295 abstract.jpg
\documentclass[tikz, border=0pt]{standalone}
\usepackage{tikz}
\usepackage{xcolor}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, backgrounds, calc, fit}
% --- Palette ---
\definecolor{cBase}{HTML}{34495E}
\definecolor{cP1}{HTML}{D4740E}
\definecolor{cP2}{HTML}{2471A3}
\definecolor{cP3}{HTML}{1E8449}
\definecolor{cOut}{HTML}{7D3C98}
\definecolor{cDanger}{HTML}{C0392B}
\definecolor{cBg}{HTML}{F2F4F6}
\definecolor{cText}{HTML}{2C3E50}

\begin{document}
\begin{tikzpicture}[
    box/.style n args={2}{
        rectangle, rounded corners=3pt, fill=#1, draw=#1!80!black, line width=0.4pt,
        minimum width=#2, minimum height=1.0cm, inner sep=4pt, align=center,
        font=\sffamily\color{white}
    },
    arrow/.style={-{Stealth[round, length=3pt, width=3pt]}, line width=0.9pt, draw=cText!50},
]

% ===== TOP: Baseline (single box, centered) =====
\node[box={cBase}{5.2cm}, minimum height=1.2cm] (base) at (6.8, 1.85) {
    {\bfseries\large ViT-MIL Baseline}\\[2pt]
    {\small Phikon encoder + Gated Attention Pooling}\\[0pt]
    {\small\color{white!85} ACC 93.4\% \quad|\quad \color{cDanger!30!white}\bfseries FNR 16.1\%}
};

% ===== MIDDLE: Three Phases =====
\node[box={cP1}{3.8cm}, minimum height=1.6cm] (p1) at (0.8, -0.3) {
    {\bfseries Phase I}\\[1pt]
    {\footnotesize Cost-Sensitive Learning}\\[2pt]
    {\scriptsize Reweight loss $w_1\!:\!w_0=10\!:\!1$}\\[0pt]
    {\scriptsize Penalize missed MIP cases}\\[2pt]
    {\bfseries FNR $\downarrow$ 3.6\% \quad|\quad Heuristic}
};

\node[box={cP2}{3.8cm}, minimum height=1.6cm] (p2) at (6.8, -0.3) {
    {\bfseries Phase II}\\[1pt]
    {\footnotesize NP Calibration}\\[2pt]
    {\scriptsize Order-statistic threshold}\\[0pt]
    {\scriptsize $\mathbb{P}(\text{FNR}\!>\!\alpha)\leq\delta$}\\[2pt]
    {\bfseries FNR $\leq\alpha$ guaranteed}
};

\node[box={cP3}{3.8cm}, minimum height=1.6cm] (p3) at (12.8, -0.3) {
    {\bfseries Phase III}\\[1pt]
    {\footnotesize Selective Classification}\\[2pt]
    {\scriptsize SelectiveNet + CRC calibration}\\[0pt]
    {\scriptsize Accept / Defer uncertain}\\[2pt]
    {\bfseries Cov.\ 91\% \quad FNR 5.1\%}
};

% ===== BOTTOM: Deployment =====
\node[box={cOut}{5.2cm}, minimum height=1.1cm] (out) at (6.8, -2.35) {
    {\bfseries\large Clinical Deployment}\\[2pt]
    {\small Safe automated diagnosis \quad|\quad Uncertain $\to$ pathologist review}
};

% ===== ARROWS: Baseline → three Phases =====
\draw[arrow] (base.south west) .. controls +(down:0.5cm) and +(up:0.5cm) .. (p1.north);
\draw[arrow] (base.south)       -- (p2.north);
\draw[arrow] (base.south east)  .. controls +(down:0.5cm) and +(up:0.5cm) .. (p3.north);

% ===== ARROWS: three Phases → Deployment =====
\draw[arrow] (p1.south east) .. controls +(down:0.4cm) and +(up:0.4cm) .. (out.north west);
\draw[arrow] (p2.south)       -- (out.north);
\draw[arrow] (p3.south west)  .. controls +(down:0.4cm) and +(up:0.4cm) .. (out.north east);

% ===== PHASE LABELS =====
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] at (3.1, 1.1)  {\textsc{Training}};
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] at (6.8, 1.1)  {\textsc{Calibration}};
\node[font=\sffamily\scriptsize\bfseries, text=cText!60] at (10.5, 1.1) {\textsc{Decision}};

% ===== FNR PROGRESSION BAR =====
\begin{scope}[on background layer]
    \fill[cBg, rounded corners=3pt] (-1.0, -3.5) rectangle (14.6, -4.2);
\end{scope}

\node[font=\sffamily\footnotesize, text=cText] at (6.8, -3.85) {
    \color{cDanger}\textbf{FNR 16.1\%}
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP1}\textbf{FNR 3.6\%}\ (heuristic)
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP2}\textbf{FNR $\leq\alpha$}\ (guaranteed)
    \quad$\boldsymbol{\rightarrow}$\quad
    \color{cP3}\textbf{FNR 5.1\%}\ (safe + deployable)
};

% ===== SUBTITLE =====
\node[font=\sffamily\bfseries\Large, text=cText] at (6.8, 3.3) {
    A Risk-Controlled Framework with Guaranteed Confidence
};
\node[font=\sffamily\small, text=cText!60] at (6.8, 2.8) {
    for Lung Adenocarcinoma MIP Subtype Classification
};

\end{tikzpicture}
\end{document}
