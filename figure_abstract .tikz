% Graphical Abstract — IEEE JBHI (660 × 295 px, aspect 2.24:1)
% Compile: pdflatex → convert -density 300 out.pdf -resize 660x295 abstract.jpg
\documentclass[tikz, border=0pt]{standalone}
\usepackage{tikz}
\usepackage{xcolor}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, backgrounds, calc, fit, patterns}
% --- Bold saturated palette ---
\definecolor{cBase}{HTML}{34495E}   % dark blue-gray: baseline
\definecolor{cP1}{HTML}{D4740E}     % deep amber: CSL
\definecolor{cP2}{HTML}{2471A3}     % steel blue: NP
\definecolor{cP3}{HTML}{1E8449}     % forest green: Selective
\definecolor{cOut}{HTML}{7D3C98}    % purple: output
\definecolor{cDanger}{HTML}{C0392B} % red: FNR
\definecolor{cBg}{HTML}{F0F3F5}
\definecolor{cText}{HTML}{2C3E50}
\begin{document}
\begin{tikzpicture}[
    box/.style n args={2}{
        rectangle, rounded corners=4pt, fill=#1, draw=#1!80!black, line width=0.5pt,
        minimum width=#2, minimum height=1.4cm, inner sep=5pt, align=center,
        font=\sffamily\color{white}, text=white
    },
    arrow/.style={-{Stealth[round, length=4pt, width=4pt]}, line width=1.1pt, draw=cText!60},
    smalltext/.style={font=\sffamily\scriptsize\color{white}},
    bigtext/.style={font=\sffamily\bfseries\color{white}},
]

% ===== TITLE =====
\node[font=\sffamily\bfseries\large, text=cText] at (9.5, 1.5) {
    A Risk-Controlled Framework for MIP Subtype Classification in Lung Adenocarcinoma
};

% ===== PIPELINE: 6 boxes, solid fill =====
% spacing: 3.5cm between centers, boxes 3.0cm wide

\node[box={cBase}{2.8cm}] (base) at (0, 0) {
    \bigtext ViT-MIL Baseline\\[2pt]
    \smalltext Phikon + Gated Attention\\[2pt]
    \smalltext ACC 93.4\% \quad FNR {\color{white}\bfseries 16.1\%}
};

\node[box={cP1}{2.8cm}] (p1) at (3.8, 0) {
    \bigtext Phase I\\[2pt]
    \smalltext Cost-Sensitive Learning\\[2pt]
    \smalltext $w_1\!:\!w_0 = 10\!:\!1$ \quad FNR $\rightarrow$ {\bfseries 3.6\%}
};

\node[box={cP2}{2.8cm}] (p2) at (7.6, 0) {
    \bigtext Phase II\\[2pt]
    \smalltext Neyman--Pearson Calibration\\[2pt]
    \smalltext $\mathbb{P}(\text{FNR}>\alpha)\leq\delta$
};

\node[box={cP3}{2.8cm}] (p3) at (11.4, 0) {
    \bigtext Phase III\\[2pt]
    \smalltext Selective Classification\\[2pt]
    \smalltext Confident $\rightarrow$ accept, Uncertain $\rightarrow$ defer
};

\node[box={cOut}{2.8cm}] (out) at (15.2, 0) {
    \bigtext Clinical Deployment\\[2pt]
    \smalltext Coverage {\bfseries 91.0\%}\\[2pt]
    \smalltext FNR {\bfseries 5.1\%} (guaranteed)
};

% Arrows
\draw[arrow, white!60!black] (base.east) -- (p1.west);
\draw[arrow, white!60!black] (p1.east)   -- (p2.west);
\draw[arrow, white!60!black] (p2.east)   -- (p3.west);
\draw[arrow, white!60!black] (p3.east)   -- (out.west);

% Arrow annotations
\node[font=\sffamily\tiny, text=cText!70, anchor=south] at ($(base.east)!0.5!(p1.west) + (0,0.05)$) {retrain};
\node[font=\sffamily\tiny, text=cText!70, anchor=south] at ($(p1.east)!0.5!(p2.west) + (0,0.05)$) {calibrate};
\node[font=\sffamily\tiny, text=cText!70, anchor=south] at ($(p2.east)!0.5!(p3.west) + (0,0.05)$) {add reject};
\node[font=\sffamily\tiny, text=cText!70, anchor=south] at ($(p3.east)!0.5!(out.west) + (0,0.05)$) {deploy};

% ===== Phase labels above =====
\node[font=\sffamily\footnotesize\bfseries, text=cText] at (0, 0.95)    {Backbone};
\node[font=\sffamily\footnotesize\bfseries, text=cP1]   at (3.8, 0.95)  {Training};
\node[font=\sffamily\footnotesize\bfseries, text=cP2]   at (7.6, 0.95)  {Calibration};
\node[font=\sffamily\footnotesize\bfseries, text=cP3]   at (11.4, 0.95) {Decision};
\node[font=\sffamily\footnotesize\bfseries, text=cOut]  at (15.2, 0.95) {Output};

% ===== FNR METRIC BAR (bottom) =====
\begin{scope}[on background layer]
    \fill[cBg, rounded corners=4pt] (0.2, -1.7) rectangle (18.0, -2.9);
\end{scope}

% Metric callouts aligned under each box
\node[font=\sffamily\footnotesize, align=center, text=cText] at (0, -2.3) {
    {\bfseries\color{cDanger} Problem}\\[1pt]
    Imbalanced\\
    High FNR
};

\node[font=\sffamily\footnotesize, align=center, text=cText] at (3.8, -2.3) {
    {\bfseries\color{cP1} Phase I}\\[1pt]
    Penalize FN\\
    Heuristic only
};

\node[font=\sffamily\footnotesize, align=center, text=cText] at (7.6, -2.3) {
    {\bfseries\color{cP2} Phase II}\\[1pt]
    Formal FNR bound\\
    Cost: specificity
};

\node[font=\sffamily\footnotesize, align=center, text=cText] at (11.4, -2.3) {
    {\bfseries\color{cP3} Phase III}\\[1pt]
    Reject uncertain\\
    Recover coverage
};

\node[font=\sffamily\footnotesize, align=center, text=cText] at (15.2, -2.3) {
    {\bfseries\color{cOut} Result}\\[1pt]
    FNR 16.1\% $\rightarrow$ 5.1\%\\
    Coverage 91.0\%
};

% thin connectors from boxes to metrics
\foreach \x/\c in {0/cBase, 3.8/cP1, 7.6/cP2, 11.4/cP3, 15.2/cOut} {
    \draw[\c!30, line width=0.4pt, densely dotted] (\x, -0.72) -- (\x, -1.65);
}

% ===== BOTTOM LINE =====
\node[font=\sffamily\bfseries\small, text=cText] at (9.5, -3.3) {
    Cost-sensitive training
    $\boldsymbol{\rightarrow}$
    Statistical safety guarantee
    $\boldsymbol{\rightarrow}$
    Human-in-the-loop selective classification
};

\end{tikzpicture}
\end{document}
