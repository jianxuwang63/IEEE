% Graphical Abstract — IEEE JBHI (660 × 295 px, aspect ~2.24:1)
% Compile: pdflatex → convert -density 300 out.pdf -resize 660x295 abstract.jpg
\documentclass[tikz, border=0pt]{standalone}
\usepackage{tikz}
\usepackage{xcolor}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, backgrounds, calc, fit}
% --- Palette ---
\definecolor{cBase}{HTML}{34495E}    % dark navy
\definecolor{cP1}{HTML}{D4740E}      % amber
\definecolor{cP2}{HTML}{2471A3}      % steel blue
\definecolor{cP3}{HTML}{1E8449}      % forest green
\definecolor{cOut}{HTML}{7D3C98}     % purple
\definecolor{cDanger}{HTML}{C0392B}
\definecolor{cBg}{HTML}{F2F4F6}
\definecolor{cText}{HTML}{2C3E50}

\begin{document}
\begin{tikzpicture}[
    box/.style n args={2}{
        rectangle, rounded corners=3pt, fill=#1, draw=#1!80!black, line width=0.4pt,
        minimum width=#2, minimum height=1.5cm, inner sep=4pt, align=center,
        font=\sffamily\color{white}
    },
    arrow/.style={-{Stealth[round, length=4pt, width=4pt]}, line width=1.0pt, draw=cText!50},
    lbl/.style={font=\sffamily\tiny\bfseries, text=cText!60, anchor=south},
]

% ===== TITLE =====
\node[font=\sffamily\bfseries\large, text=cText] at (7.5, 2.2) {
    A Risk-Controlled Framework for MIP Subtype Classification
};

% ===== MAIN PIPELINE: 5 boxes, compact =====
% Total width ~15cm, box width 2.6cm, gap 0.6cm

\node[box={cBase}{2.6cm}] (base) at (0, 0.4) {
    {\bfseries ViT-MIL}\\[1pt]
    {\scriptsize Baseline}\\[2pt]
    {\scriptsize ACC 93.4\%}\\[0pt]
    {\scriptsize\bfseries FNR 16.1\%}
};

\node[box={cP1}{2.6cm}] (p1) at (3.4, 0.4) {
    {\bfseries Phase I}\\[1pt]
    {\scriptsize Cost-Sensitive}\\[2pt]
    {\scriptsize $w_1\!:\!w_0=10\!:\!1$}\\[0pt]
    {\scriptsize\bfseries FNR $\rightarrow$ 3.6\%}
};

\node[box={cP2}{2.6cm}] (p2) at (6.8, 0.4) {
    {\bfseries Phase II}\\[1pt]
    {\scriptsize NP Calibration}\\[2pt]
    {\scriptsize $\mathbb{P}(\text{FNR}\!>\!\alpha)\leq\delta$}\\[0pt]
    {\scriptsize Formal guarantee}
};

\node[box={cP3}{2.6cm}] (p3) at (10.2, 0.4) {
    {\bfseries Phase III}\\[1pt]
    {\scriptsize SelectiveNet + CRC}\\[2pt]
    {\scriptsize Accept / Defer}\\[0pt]
    {\scriptsize\bfseries Cov.\ 91\%\ FNR 5.1\%}
};

\node[box={cOut}{2.6cm}] (out) at (13.6, 0.4) {
    {\bfseries Deployment}\\[3pt]
    {\scriptsize Safe automated diagnosis}\\[0pt]
    {\scriptsize Uncertain $\rightarrow$ pathologist}
};

% Arrows
\draw[arrow] (base.east) -- (p1.west);
\draw[arrow] (p1.east)   -- (p2.west);
\draw[arrow] (p2.east)   -- (p3.west);
\draw[arrow] (p3.east)   -- (out.west);

% Phase type labels above
\node[font=\sffamily\footnotesize\bfseries, text=cText!70] at (0, 1.35)    {Backbone};
\node[font=\sffamily\footnotesize\bfseries, text=cP1]       at (3.4, 1.35)  {Training};
\node[font=\sffamily\footnotesize\bfseries, text=cP2]       at (6.8, 1.35)  {Calibration};
\node[font=\sffamily\footnotesize\bfseries, text=cP3]       at (10.2, 1.35) {Decision};
\node[font=\sffamily\footnotesize\bfseries, text=cOut]      at (13.6, 1.35) {Output};

% Arrow labels
\node[lbl] at ($(base.east)!0.5!(p1.west) + (0,0.05)$) {retrain};
\node[lbl] at ($(p1.east)!0.5!(p2.west) + (0,0.05)$)   {calibrate};
\node[lbl] at ($(p2.east)!0.5!(p3.west) + (0,0.05)$)   {add reject};
\node[lbl] at ($(p3.east)!0.5!(out.west) + (0,0.05)$)  {deploy};

% ===== BOTTOM SECTION =====
\begin{scope}[on background layer]
    \fill[cBg, rounded corners=4pt] (-1.2, -1.8) rectangle (15.0, -3.2);
\end{scope}

% FNR progression bar
\node[font=\sffamily\scriptsize\bfseries, text=cText] at (1.7, -2.3)  {\color{cDanger}FNR 16.1\%};
\node[font=\sffamily\scriptsize, text=cText!60]       at (4.25, -2.3) {$\longrightarrow$};
\node[font=\sffamily\scriptsize\bfseries, text=cP1]   at (5.1, -2.3)  {FNR 3.6\%};
\node[font=\sffamily\scriptsize, text=cText!60]       at (7.2, -2.3) {$\longrightarrow$};
\node[font=\sffamily\scriptsize\bfseries, text=cP2]   at (8.0, -2.3)  {FNR $\leq\alpha$};
\node[font=\sffamily\scriptsize, text=cText!60]       at (10.3, -2.3){$\longrightarrow$};
\node[font=\sffamily\scriptsize\bfseries, text=cP3]   at (11.3, -2.3){FNR 5.1\%};
\node[font=\sffamily\scriptsize, text=cText!60]       at (13.1, -2.3){$\longrightarrow$};
\node[font=\sffamily\scriptsize\bfseries, text=cOut]  at (14.2, -2.3){Safe};

% Three-pillar summary
\node[font=\sffamily\footnotesize, align=center, text width=4.2cm, text=cText] at (2.5, -2.85) {
    {\bfseries\color{cDanger} Problem}\\[0pt]
    {\scriptsize MIP rare + aggressive}\\[-1pt]
    {\scriptsize Standard models: high FNR}
};
\node[font=\sffamily\footnotesize, align=center, text width=4.2cm, text=cText] at (7.5, -2.85) {
    {\bfseries\color{cP2} Approach}\\[0pt]
    {\scriptsize CSL $\rightarrow$ NP $\rightarrow$ Selective}\\[-1pt]
    {\scriptsize Penalize $\rightarrow$ Guarantee $\rightarrow$ Defer}
};
\node[font=\sffamily\footnotesize, align=center, text width=4.2cm, text=cText] at (12.5, -2.85) {
    {\bfseries\color{cP3} Outcome}\\[0pt]
    {\scriptsize FNR 16.1\% $\rightarrow$ 5.1\%}\\[-1pt]
    {\scriptsize Coverage 91\%\ with formal guarantee}
};

% Dividers
\draw[cText!15, line width=0.3pt] (5.1, -2.5) -- (5.1, -3.1);
\draw[cText!15, line width=0.3pt] (10.0, -2.5) -- (10.0, -3.1);

\end{tikzpicture}
\end{document}
